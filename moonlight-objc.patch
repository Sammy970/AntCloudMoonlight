 #import "AppDelegate.h"
+#import <objc/message.h>
+
+// AntCloud: iOS 27 refuses to launch apps built with its SDK that don't use the UIScene life cycle. UIKit still
+// builds the window from the storyboard named in Info.plist (UISceneStoryboardFile); this delegate is what scene
+// apps use to receive the home-screen shortcuts that the app delegate used to get.
+@interface AntCloudSceneDelegate : UIResponder <UIWindowSceneDelegate>
+@property (strong, nonatomic) UIWindow *window;
+@end
+
+@implementation AntCloudSceneDelegate
+
+#if !TARGET_OS_TV
+- (void)scene:(UIScene *)scene willConnectToSession:(UISceneSession *)session options:(UISceneConnectionOptions *)connectionOptions {
+    UIApplicationShortcutItem* shortcut = connectionOptions.shortcutItem;
+    if (shortcut != nil) {
+        ((AppDelegate*)UIApplication.sharedApplication.delegate).pcUuidToLoad = (NSString*)[shortcut.userInfo objectForKey:@"UUID"];
+    }
+}
+
+- (void)windowScene:(UIWindowScene *)windowScene performActionForShortcutItem:(UIApplicationShortcutItem *)shortcutItem completionHandler:(void (^)(BOOL succeeded))completionHandler {
+    AppDelegate* app = (AppDelegate*)UIApplication.sharedApplication.delegate;
+    app.pcUuidToLoad = (NSString*)[shortcutItem.userInfo objectForKey:@"UUID"];
+    app.shortcutCompletionHandler = completionHandler;
+}
+#endif
+
+- (void)sceneDidEnterBackground:(UIScene *)scene {
+    [(AppDelegate*)UIApplication.sharedApplication.delegate saveContext];
+}
+
+@end
 

+// Covers Moonlight's own screens in AntCloud's launch colour and logo: at launch until the panel
+// is up, and while a Play connects (with `text` and a spinner), so Moonlight's host list never shows.
+- (void) antCloudShowCover:(NSString*)text {
+    [self antCloudHideCover];
+    UIView* host = self.navigationController.view ?: self.view;
+    UIView* cover = [[UIView alloc] initWithFrame:host.bounds];
+    cover.autoresizingMask = UIViewAutoresizingFlexibleWidth | UIViewAutoresizingFlexibleHeight;
+    cover.backgroundColor = [UIColor colorNamed:@"AntCloudLaunchBackground"] ?: UIColor.systemBackgroundColor;
+
+    UIImageView* logo = [[UIImageView alloc] initWithImage:[UIImage imageNamed:@"AntCloudLaunchLogo"]];
+    CGFloat side = text == nil ? 171 : 120;
+    [logo.widthAnchor constraintEqualToConstant:side].active = YES;
+    [logo.heightAnchor constraintEqualToConstant:side].active = YES;
+    UIStackView* stack = [[UIStackView alloc] initWithArrangedSubviews:@[logo]];
+    stack.axis = UILayoutConstraintAxisVertical;
+    stack.alignment = UIStackViewAlignmentCenter;
+    stack.spacing = 6;
+    if (text != nil) {
+        UIActivityIndicatorView* spinner = [[UIActivityIndicatorView alloc] initWithActivityIndicatorStyle:UIActivityIndicatorViewStyleMedium];
+        [spinner startAnimating];
+        UILabel* label = [[UILabel alloc] init];
+        label.text = text;
+        label.font = [UIFont preferredFontForTextStyle:UIFontTextStyleHeadline];
+        label.textColor = UIColor.labelColor;
+        [stack addArrangedSubview:label];
+        [stack addArrangedSubview:spinner];
+        [stack setCustomSpacing:14 afterView:label];
+    }
+    stack.translatesAutoresizingMaskIntoConstraints = NO;
+    [cover addSubview:stack];
+    [stack.centerXAnchor constraintEqualToAnchor:cover.centerXAnchor].active = YES;
+    [stack.centerYAnchor constraintEqualToAnchor:cover.centerYAnchor].active = YES;
+    [host addSubview:cover];
+    _antCloudCover = cover;
+
+    if (text != nil) {
+        // Safety net: if the connection stalls somewhere silent, uncover Moonlight after a minute
+        // (its "AntCloud" button leads back).
+        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(60 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
+            if (self->_antCloudCover == cover) {
+                [self antCloudHideCover];
+            }
+        });
+    }
+}
+
+- (void) antCloudHideCover {
+    [_antCloudCover removeFromSuperview];
+    _antCloudCover = nil;
+}
+
+// Requested by the AntCloud panel's Play button: add the cloud PC if needed, pair (the PIN is
+// submitted automatically), then auto-launch "Desktop".
+- (void) antCloudConnectToAddress:(NSString*)address {
+    NSLog(@"[AntCloud] connect requested for %@ (%lu known hosts)", address, (unsigned long)hostList.count);
+    if (address.length == 0) {
+        return;
+    }
+    _antCloudLaunchAddress = address;
+    [self antCloudShowCover:@"Connecting to your cloud PC"];
+
+    TemporaryHost* existing = nil;
+    @synchronized(hostList) {
+        for (TemporaryHost* host in hostList) {
+            if ([self antCloudHost:host matchesAddress:address]) {
+                existing = host;
+                break;
+            }
+        }
+    }
+    if (existing != nil) {
+        NSLog(@"[AntCloud] using saved host %@ (state %d, pair state %d)", existing.name, existing.state, existing.pairState);
+        [self hostClicked:existing view:self.view];
+        return;
+    }
+    NSLog(@"[AntCloud] adding host %@", address);
+
+    [self showLoadingFrame:^{
+        dispatch_async(dispatch_get_global_queue(DISPATCH_QUEUE_PRIORITY_HIGH, 0), ^{
+            [self->_discMan discoverHost:address withCallback:^(TemporaryHost* host, NSString* error) {
+                dispatch_async(dispatch_get_main_queue(), ^{
+                    NSLog(@"[AntCloud] discover %@ → %@", address, host != nil ? host.name : error);
+                    [self hideLoadingFrame:^{
+                        if (host == nil) {
+                            self->_antCloudLaunchAddress = nil;
+                            UIAlertController* alert = [UIAlertController alertControllerWithTitle:@"Couldn't Reach Cloud PC" message:error preferredStyle:UIAlertControllerStyleAlert];
+                            [alert addAction:[UIAlertAction actionWithTitle:@"OK" style:UIAlertActionStyleDefault handler:^(UIAlertAction* action) {
+                                [self showAntCloudAnimated:YES];
+                            }]];
+                            [[self activeViewController] presentViewController:alert animated:YES completion:nil];
+                            return;
+                        }
+                        @synchronized(hostList) {
+                            [hostList addObject:host];
+                        }
+                        [self updateHosts];
+                        [self hostClicked:host view:self.view];
+                    }];
+                });
+            }];
+        });
+    }];
 }
 

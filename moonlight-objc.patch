+#pragma mark - AntCloud
+
+- (BOOL) antCloudHost:(TemporaryHost*)host matchesAddress:(NSString*)address {
+    return [host.address isEqualToString:address] || [host.activeAddress isEqualToString:address] ||
+           [host.localAddress isEqualToString:address] || [host.externalAddress isEqualToString:address];
+}
+
+- (void) showAntCloud {
+    Class panel = NSClassFromString(@"AntCloudPanel");
+    if (panel == nil) {
+        return;
+    }
+    UIViewController* controller = ((UIViewController* (*)(id, SEL))objc_msgSend)(panel, NSSelectorFromString(@"makeViewController"));
+    [[self activeViewController] presentViewController:controller animated:YES completion:nil];
+}
+
+// Requested by the AntCloud panel's Play button: add the cloud PC if needed, pair (the PIN is
+// submitted automatically), then auto-launch "Desktop".
+- (void) antCloudConnectToAddress:(NSString*)address {
+    NSLog(@"[AntCloud] connect requested for %@ (%lu known hosts)", address, (unsigned long)hostList.count);
+    if (address.length == 0) {
+        return;
+    }
+    _antCloudLaunchAddress = address;
+
+    TemporaryHost* existing = nil;
+    @synchronized(hostList) {
+        for (TemporaryHost* host in hostList) {
+            if ([self antCloudHost:host matchesAddress:address]) {
+                existing = host;
+                break;
+            }
+        }
+    }
+    if (existing != nil) {
+        NSLog(@"[AntCloud] using saved host %@ (state %d, pair state %d)", existing.name, existing.state, existing.pairState);
+        [self hostClicked:existing view:self.view];
+        return;
+    }
+    NSLog(@"[AntCloud] adding host %@", address);
+
+    [self showLoadingFrame:^{
+        dispatch_async(dispatch_get_global_queue(DISPATCH_QUEUE_PRIORITY_HIGH, 0), ^{
+            [self->_discMan discoverHost:address withCallback:^(TemporaryHost* host, NSString* error) {
+                dispatch_async(dispatch_get_main_queue(), ^{
+                    NSLog(@"[AntCloud] discover %@ → %@", address, host != nil ? host.name : error);
+                    [self hideLoadingFrame:^{
+                        if (host == nil) {
+                            self->_antCloudLaunchAddress = nil;
+                            UIAlertController* alert = [UIAlertController alertControllerWithTitle:@"Couldn't Reach Cloud PC" message:error preferredStyle:UIAlertControllerStyleAlert];
+                            [alert addAction:[UIAlertAction actionWithTitle:@"OK" style:UIAlertActionStyleDefault handler:nil]];
+                            [[self activeViewController] presentViewController:alert animated:YES completion:nil];
+                            return;
+                        }
+                        @synchronized(hostList) {
+                            [hostList addObject:host];
+                        }
+                        [self updateHosts];
+                        [self hostClicked:host view:self.view];
+                    }];
+                });
+            }];
+        });
+    }];
 }
 
